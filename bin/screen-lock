#!/bin/bash

fg=c0caf5
wrong=db4b4b
date=7aa2f7
verify=7aa2f7

lock_image="$HOME/Images/system/lock_screen.png"
temp_image="/tmp/lock_screen_scaled.png"

# Полная геометрия X11 (оба монитора)
root_res=$(xdpyinfo | awk '/dimensions/{print $2}')
echo "Root resolution: $root_res"

# Фон на ВСЮ X-сессию
convert "$lock_image" -resize "$root_res^" -gravity center -extent "$root_res" "$temp_image"

screen_res=$(xrandr | grep '*' | head -n1 | awk '{print $1}')  # Например: 2560x1440
screen_width=${screen_res%x*}   # 2560
screen_height=${screen_res#*x}  # 1440

date_time_radiusi=$((screen_width / screen_height * 25 ))

gap=$((screen_width / screen_height * 200 ))       # расстояние между временем и текстом приветствия 400

time_x=$((screen_width / 2))
time_y=$((screen_height / 2))   # например, 540 пикселей от верхнего края

index_x=$((time_x))
index_y=$((time_y+gap - 70))

data=70		# расстояние между датой и временем
greeter_x=$time_x
greeter_y=$((time_y + gap))
data_y=$((time_y + data))

setxkbmap us # смена раскладки при блокировки

 # Запускаем i3lock один раз на основном экране (экран 0)
i3lock -n --force-clock \
-i "$temp_image" -e --indicator \
--ind-pos="${index_x}:${index_y}" \
--radius=${date_time_radiusi} --ring-width=40 \
--inside-color=$fg --ring-color=$fg \
--insidever-color=$verify --ringver-color=$verify \
--insidewrong-color=$wrong --ringwrong-color=$wrong \
--line-uses-inside \
--keyhl-color=$verify --separator-color=$verify --bshl-color=$verify \
--time-pos="${time_x}:${time_y}" \
--date-pos="${greeter_x}:${data_y}" \
--time-str="%H:%M" --date-str="%a, %d %b" \
--time-size=100 --date-size=45 \
--greeter-pos="${greeter_x}:${greeter_y}" \
--time-font="FiraCode-Bold" --date-font="FiraCode-Regular" --verif-font="FiraCode-Regular" \
--wrong-font="FiraCode-Regular" --greeter-font="FiraCode-Regular" \
--verif-size=23 --greeter-size=23 --wrong-size=23 \
--date-color=$date --time-color=$date --greeter-color=$fg --wrong-color=$wrong --verif-color=$verify \
--screen=0
